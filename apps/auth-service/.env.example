# Auth Service — run from repo root
PORT=5001
CORS_ORIGIN=http://localhost:8000

# Swagger (Try-it-out requests go through the gateway)
SWAGGER_ENABLED=true
SWAGGER_TITLE=RashPulse Auth Microservice
SWAGGER_DESCRIPTION=User signup, login aur security endpoints
SWAGGER_VERSION=1.0.0
SWAGGER_SERVER_URL=http://localhost:8000/api/v1/auth
