# API Gateway — run from repo root
PORT=8000

# Downstream microservice URLs (internal)
AUTH_SERVICE_URL=http://localhost:5001
PRODUCT_SERVICE_URL=http://localhost:5002
ORDER_SERVICE_URL=http://localhost:5003

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE=RashPulse API Gateway
SWAGGER_DESCRIPTION=Central API documentation for all RashPulse microservices
SWAGGER_VERSION=1.0.0
